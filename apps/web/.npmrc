# Network tuning for pnpm installs. The @next/swc and sharp-libvips tarballs
# are large (tens of MB) and the default 60s per-request fetch-timeout can be
# hit on slow/flaky connections (notably inside Docker). Give fetches room and
# lower concurrency so a single stalled socket doesn't cascade.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
network-concurrency=4

# pnpm 11 verifies (and may auto-install) dependencies before running any
# script. In the Docker builder stage node_modules is copied from the deps
# stage and is already complete, so re-verification only triggers needless
# (and here, flaky) network installs. Trust the copied node_modules instead.
verify-deps-before-run=false
