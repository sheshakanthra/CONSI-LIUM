# CONSILIUM web environment. Copy to `.env.local` (Next.js convention) and fill.
# Only NEXT_PUBLIC_* vars are exposed to the browser bundle — keep secrets out
# of those.

# Base URL the browser uses to reach the API. Under docker-compose the browser
# runs on the host, so this points at the published host port, not the compose
# service name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
