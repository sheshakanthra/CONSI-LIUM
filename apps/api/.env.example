# CONSILIUM API environment. Copy to `.env` and fill in.
# NEVER commit the real .env (see root .gitignore). No hardcoded keys anywhere
# in code — every value the app reads is declared here (CLAUDE.md rule).

# --- Database ---------------------------------------------------------------
# Async driver scheme is required (postgresql+asyncpg://...).
# Host is the compose service name "db" when running under docker-compose,
# or "localhost" when running the API directly on the host.
DATABASE_URL=postgresql+asyncpg://consilium:consilium@db:5432/consilium

# --- Service metadata -------------------------------------------------------
APP_NAME=consilium-api
ENVIRONMENT=development

# --- Agents: LLM provider (Phase 3) -----------------------------------------
# The reasoning agents (bull/bear/fact-checker) call an LLM behind one seam
# (agents/llm_client.py). Pick the provider; only that provider's key is needed.
# Ingestion, retrieval, and the test suite do NOT need any LLM key (tests mock it).
#
#   groq       -> free developer tier, OpenAI-compatible API (default)
#   anthropic  -> Claude (paid) — same interface, swap when credits are available
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq). Get a free key at https://console.groq.com.
GROQ_API_KEY=gsk_your_real_key_here
# Current fast general-purpose production model; override to try another.
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic / Claude (used when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=sk-ant-your-real-key-here
# Claude model when on the anthropic provider (cheap default; e.g. claude-opus-4-8 to upgrade).
AGENT_MODEL=claude-haiku-4-5